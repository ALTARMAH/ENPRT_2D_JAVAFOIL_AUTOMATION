BT 1 0 0 1 0 172.4 Tm /F3 7.6 Tf 10 TL (def build_panels\(outs, max_spacing=0.008\):) Tj T* (    """Panel list {p1, p2, m, s, t, n, el} for each element outline, cw, outward normals.""") Tj T* (    panels = []) Tj T* (    starts = []) Tj T* (    decs = []) Tj T* (    centroid = np.zeros\(2\)) Tj T* (    total = sum\(len\(o\) for o in outs\)) Tj T* (    for o in outs:) Tj T* (        centroid += o.sum\(axis=0\)) Tj T* (    centroid /= max\(total, 1\)) Tj T* (    for ei, o0 in enumerate\(outs\):) Tj T* (        o = _orient_out\(o0\)) Tj T* (        if max_spacing > 0:) Tj T* (            cum = np.concatenate\([[0], np.cumsum\(np.hypot\(np.diff\(o[:, 0]\), np.diff\(o[:, 1]\)\)\)]\)) Tj T* (            want = max\(8, int\(cum[-1] / max_spacing\)\)) Tj T* (            if want < len\(o\):) Tj T* (                idx = np.unique\(np.linspace\(0, len\(o\) - 1, want\).astype\(int\)\)) Tj T* (                o = o[idx]) Tj T* ET
Q
 
