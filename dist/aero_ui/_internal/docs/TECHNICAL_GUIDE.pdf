BT 1 0 0 1 0 262.4 Tm /F3 7.6 Tf 10 TL (def parse_polar\(path\):) Tj T* (    lines = [l for l in read_text\(path\).splitlines\(\) if l.strip\(\)]) Tj T* (    head = lines[:15]) Tj T* (    hdr = next\(\(i for i, l in enumerate\(lines\)) Tj T* (                if re.search\(r"alpha|) Tj /F5 7.6 Tf 10 TL (a) Tj /F3 7.6 Tf 10 TL (", l, re.I\) and re.search\(r"\\bcl\\b", l, re.I\)\), -1\)) Tj T* (    if hdr == -1:) Tj T* (        return None, head) Tj T*  T* (    def split\(l\):) Tj T* (        if "\\t" in l: return [t.strip\(\) for t in l.split\("\\t"\) if t.strip\(\)]) Tj T* (        if ";" in l:  return [t.strip\(\) for t in l.split\(";"\) if t.strip\(\)]) Tj T* (        return l.split\(\)) Tj T*  T* (    cols = [c.lower\(\) for c in split\(lines[hdr]\)]) Tj T* (    cols = ["alpha" if c in \(") Tj /F5 7.6 Tf 10 TL (a) Tj /F3 7.6 Tf 10 TL (", "a", "alpha"\) else c for c in cols]) Tj T* (    rows = []) Tj T* (    for l in lines[hdr + 1:]:) Tj T* (        toks = split\(l\)) Tj T* (        if len\(toks\) < len\(cols\):) Tj T* (            continue) Tj T* (        try:) Tj T* (            rows.append\([float\(t.strip\(\).replace\(",", "."\)\) for t in toks[:len\(cols\)]]\)) Tj T* (        except ValueError:) Tj T* (            continue) Tj T* (    if not rows:) Tj T* (        return None, head) Tj T* (    return pd.DataFrame\(rows, columns=cols\), head) Tj T* ET
