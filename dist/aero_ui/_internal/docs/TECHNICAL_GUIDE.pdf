BT 1 0 0 1 0 312.4 Tm /F3 7.6 Tf 10 TL (def _drain_ui\(self\):) Tj T* (    # Never let one bad message \(or a UI callback that raises\) kill the update loop: the timer is) Tj T* (    # always rescheduled in the finally block, so the window cannot freeze permanently.) Tj T* (    try:) Tj T* (        while True:) Tj T* (            try:) Tj T* (                kind, payload = self.ui_q.get_nowait\(\)) Tj T* (            except queue.Empty:) Tj T* (                break) Tj T* (            try:) Tj T* (                if kind == "log":) Tj T* (                    self._append_log\(self.status, payload\)) Tj T* (                elif kind == "camp":) Tj T* (                    self._append_log\(self.cam_log, payload,) Tj T* (                                     follow=self.cam_follow.get\(\)\)) Tj T* (                elif kind == "load":) Tj T* (                    self.load_results_cache\(\)) Tj T* (                    self.refresh_graph_files\(\)) Tj T* (                elif kind == "cam_evt":) Tj T* (                    self._cam_evt\(*payload\)) Tj T* (                elif kind == "cam_done":) Tj T* (                    self._cam_done\(payload\)) Tj T* (                elif kind == "aflog":) Tj T* (                    self._append_log\(self.af_log, payload\)) Tj T* (                elif kind == "refreshgr":) Tj T* (                    self.refresh_graph_files\(payload or None\)) Tj T* (                elif kind == "opt_log":) Tj T* (                    self._append_log\(self.opt_log, payload\)) Tj T* (                elif kind == "opt_prog":) Tj T* (                    self.opt_progress["value"] = payload) Tj T* (                elif kind == "opt_status":) Tj T* (                    self.opt_status.set\(payload\)) Tj T* ET
Q
 
