BT 1 0 0 1 0 82.4 Tm /F3 7.6 Tf 10 TL (def element_circulation\(outs, Cls, alpha\):) Tj T* (    """Per element: normalised strength Gamma_e \(uses Cl per element or a thin-airfoil guess\).""") Tj T* (    a = np.radians\(alpha\)) Tj T* (    G = np.zeros\(len\(outs\)\)) Tj T* (    for ei, o in enumerate\(outs\):) Tj T* (        c = o[:, 0].max\(\) - o[:, 0].min\(\)) Tj T* (        cl = Cls[ei] if Cls is not None and ei < len\(Cls\) and Cls[ei] is not None else 2 * np.pi * np.sin\(a\)) Tj T* (        G[ei] = -cl * UINF * max\(c, 1e-9\) / 2.0) Tj T* (    return G) Tj T* ET
