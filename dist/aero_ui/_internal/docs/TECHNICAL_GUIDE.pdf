BT 1 0 0 1 0 462.4 Tm /F3 7.6 Tf 10 TL (    FIELDS\). A plain read_csv\(on_bad_lines="skip"\) silently discards the wider rows, so this splits) Tj T* (    the file into groups by field count and parses each group with the column names that belong to) Tj T* (    it \(the file header for header-width rows, FIELDS for current-width rows\). The groups are then) Tj T* (    concatenated, so every row is kept.""") Tj T* (    if not path or not os.path.exists\(path\):) Tj T* (        return pd.DataFrame\(\)) Tj T* (    try:) Tj T* (        with open\(path, "r", newline="", errors="ignore"\) as f:) Tj T* (            rows = [r for r in csv.reader\(f\) if r and any\(str\(x\).strip\(\) for x in r\)]) Tj T* (    except OSError:) Tj T* (        return pd.DataFrame\(\)) Tj T* (    if not rows:) Tj T* (        return pd.DataFrame\(\)) Tj T* (    header, data = rows[0], rows[1:]) Tj T* (    groups = {}) Tj T* (    for r in data:                                    # preserve first-seen order of widths) Tj T* (        groups.setdefault\(len\(r\), []\).append\(r\)) Tj T* (    frames = []) Tj T* (    odd = []) Tj T* (    for width, rws in groups.items\(\):) Tj T* (        buf = io.StringIO\(\)) Tj T* (        w = csv.writer\(buf\)) Tj T* (        if width == len\(header\):) Tj T* (            w.writerow\(header\)) Tj T* (            w.writerows\(rws\)) Tj T* (            buf.seek\(0\)) Tj T* (            frames.append\(pd.read_csv\(buf, on_bad_lines="skip", low_memory=False\)\)) Tj T* (        else:) Tj T* (            if width == len\(FIELDS\):) Tj T* (                cols = FIELDS) Tj T* (            elif width == len\(FIELDS\) - 1:) Tj T* (                cols = FIELDS[:width]                    # previous layout \(before Speed_ms was appended\)) Tj T* (            elif width <= len\(header\):) Tj T* (                cols = header[:width]                    # trust the file's own header names) Tj T* (            else:) Tj T* (                cols = FIELDS[:width]) Tj T* (                odd.append\(width\)) Tj T* (            w.writerows\(rws\)) Tj T* (            buf.seek\(0\)) Tj T* (            frames.append\(pd.read_csv\(buf, header=None, names=cols, on_bad_lines="skip", low_memory=False\)\)) Tj T* (    if odd:) Tj T* (        print\(f"\(warning: {path} has rows of unexpected width {sorted\(set\(odd\)\)}; ") Tj T* (              f"read with a best-effort column mapping - please review the file\)"\)) Tj T* (    if not frames:) Tj T* (        return pd.DataFrame\(columns=header\)) Tj T* (    d = pd.concat\(frames, ignore_index=True, sort=False\)) Tj T* (    return d.loc[:, ~d.columns.duplicated\(\)]) Tj T* ET
