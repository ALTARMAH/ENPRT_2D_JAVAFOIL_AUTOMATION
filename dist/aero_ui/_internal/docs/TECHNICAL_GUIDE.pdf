BT 1 0 0 1 0 142.4 Tm /F3 7.6 Tf 10 TL (def rate\(m, status\):) Tj T* (    """Returns \(tier, score\). Tier 4 = rejected.""") Tj T* (    if status != "Valid" or m is None:) Tj T* (        return 4, float\("nan"\)) Tj T* (    cl0, cd0, st = m["Cl_a0"], m["Cd_a0"], m["Stall_Angle"]) Tj T* (    if any\(pd.isna\(v\) for v in \(cl0, cd0, st\)\) or cl0 >= 0 or cd0 <= 0 or cd0 > CD_MAX or st <= ALPHA[0]:) Tj T* (        return 4, float\("nan"\)) Tj T* (    margin = DESIGN_ALPHA - st) Tj T* (    tier = 1 if margin >= TIER1_MARGIN else 2 if margin >= TIER2_MARGIN else 3) Tj T* (    df_s = clip01\(\(abs\(cl0\) - DF_LO\) / \(DF_HI - DF_LO\)\)) Tj T* (    mg_s = clip01\(margin / MARGIN_FULL\)) Tj T* (    ef_s = clip01\(\(abs\(cl0\) / cd0 - LD_LO\) / \(LD_HI - LD_LO\)\)) Tj T* (    lo = min\(abs\(m["Cl_am2"]\), abs\(m["Cl_ap2"]\)\) if pd.notna\(m["Cl_am2"]\) and pd.notna\(m["Cl_ap2"]\) else float\("nan"\)) Tj T* (    rb_s = clip01\(\(lo / abs\(cl0\) - 0.8\) / 0.2\) if pd.notna\(lo\) else 0.5) Tj T* (    return tier, 100 * \(W_DF * df_s + W_MG * mg_s + W_EF * ef_s + W_RB * rb_s\)) Tj T* ET
Q
