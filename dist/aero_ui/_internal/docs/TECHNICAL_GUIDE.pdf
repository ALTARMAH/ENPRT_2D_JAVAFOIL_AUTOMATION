BT 1 0 0 1 0 172.4 Tm /F3 7.6 Tf 10 TL (def select_top\(d, n\):) Tj T* (    """Round-robin across element counts so the top list contains every stack type if possible.""") Tj T* (    if "Elements" not in d.columns or n < 2 or len\(d\) <= n:) Tj T* (        return quality_rank\(d\).head\(n\)) Tj T* (    d = d.copy\(\)) Tj T* (    groups = [g for _, g in d.groupby\("Elements"\) if not g.empty]) Tj T* (    picked = []) Tj T* (    i = 0) Tj T* (    while len\(picked\) < n and groups:) Tj T* (        for g in groups:) Tj T* (            if len\(picked\) >= n:) Tj T* (                break) Tj T* (            if i < len\(g\):) Tj T* (                picked.append\(g.iloc[i]\)) Tj T* (        i += 1) Tj T* (        groups = [g for g in groups if i < len\(g\)]) Tj T* (    top = pd.DataFrame\(picked\)) Tj T* (    return quality_rank\(pd.concat\([top, d.drop\(top.index\)]\)\)[:n]) Tj T* ET
