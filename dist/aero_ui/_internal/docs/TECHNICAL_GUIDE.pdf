.945098 .960784 .976471 rg
BT 1 0 0 1 0 152.4 Tm /F3 7.6 Tf 10 TL (def build_outlines\(cfg, ground_h=UNSET\):) Tj T* (    """Outlines of all elements. In ground effect every element is translated up by the wing height.""") Tj T* (    h = GROUND_H if ground_h is UNSET else ground_h) Tj T* (    if h is not None:) Tj T* (        h = validate_height\(h\)) Tj T* (    main, flaps = cfg) Tj T* (    if main not in AIRFOILS:) Tj T* (        raise KeyError\(f"unknown main airfoil: {main!r}"\)) Tj T* (    outs = [AIRFOILS[main]]) Tj T* (    for \(name, s, a, x, y\) in flaps:) Tj T* (        if not name or name not in AIRFOILS:) Tj T* (            raise KeyError\(f"unknown airfoil: {name!r}"\)) Tj T* (        outs.append\(transform_coords\(AIRFOILS[name], s, a, x, y\)\)) Tj T* (    if h is not None:) Tj T* (        outs = [o + np.array\([0.0, h / 100.0]\) for o in outs]) Tj T* (    return outs) Tj T* ET
