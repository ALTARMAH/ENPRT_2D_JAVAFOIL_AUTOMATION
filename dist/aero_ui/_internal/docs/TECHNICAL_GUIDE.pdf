BT 1 0 0 1 0 182.4 Tm /F3 7.6 Tf 10 TL (def geometry_ok\(cfg\):) Tj T* (    """Cheap rejection of configs that would clash, intersect or touch the ground, or that break the) Tj T* (    FSUK/FSG size limits \(never sent to JavaFoil\).""") Tj T* (    flaps = cfg[1]) Tj T* (    for k in range\(len\(flaps\) - 1\):) Tj T* (        _, s, a, x, y = flaps[k]) Tj T* (        if x + 0.8 * s >= flaps[k + 1][3]:) Tj T* (            return False) Tj T* (    outs = build_outlines\(cfg, ground_h=None\)          # untranslated: clashes are translation invariant) Tj T* (    for i, j in itertools.combinations\(range\(len\(outs\)\), 2\):) Tj T* (        if outlines_intersect\(outs[i], outs[j]\):) Tj T* (            return False) Tj T* (    mount = wing_mount_chord\(\)) Tj T* (    ymin = min\(o[:, 1].min\(\) for o in outs\)) Tj T* (    if GROUND_H is not None and mount is not None and \(mount + ymin\) * 100 < MIN_CLEARANCE_PCT:) Tj T* (        return False) Tj T* (    if regulatory_reject\(outs, mount\) is not None:) Tj T* (        return False) Tj T* (    return True) Tj T* ET
