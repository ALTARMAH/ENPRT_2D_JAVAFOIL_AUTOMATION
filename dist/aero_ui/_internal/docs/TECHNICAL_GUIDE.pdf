BT 1 0 0 1 0 142.4 Tm /F3 7.6 Tf 10 TL (def plot_polar\(r, out_png\):) Tj T* (    import matplotlib) Tj T* (    matplotlib.use\("Agg"\)) Tj T* (    import matplotlib.pyplot as plt) Tj T* (    alphas = np.array\([-2.0, 0.0, 2.0]\)) Tj T* (    cls = np.array\([float\(r.get\(c, np.nan\)\) for c in \("Cl_am2", "Cl_a0", "Cl_ap2"\)]\)) Tj T* (    fig, ax = plt.subplots\(figsize=\(7.5, 5.2\)\)) Tj T* (    if not np.isnan\(cls\).any\(\):) Tj T* (        aa = np.linspace\(-6, 6, 60\)) Tj T* (        p = np.polyfit\(alphas, cls, 2\)) Tj T* (        ax.plot\(aa, np.polyval\(p, aa\), color="#c8102e", lw=1.2, alpha=0.7, label="quadratic fit"\)) Tj T* (        ax.plot\(alphas, cls, "o", color="#0b3d91", ms=6, label="JavaFoil points"\)) Tj T* (        for a_, c_ in zip\(alphas, cls\):) Tj T* (            ax.annotate\(f"{c_:.3f}", \(a_, c_\), textcoords="offset points", xytext=\(0, 7\), fontsize=8, ha="center"\)) Tj T* (    pk = float\(r.get\("Cl_peak", np.nan\)\)) Tj T* ET
