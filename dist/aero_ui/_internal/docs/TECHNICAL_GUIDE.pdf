BT 1 0 0 1 0 362.4 Tm /F3 7.6 Tf 10 TL (def run_plan\(plan, mains, flaps_pool, check_only=False, no_check=False, resume=True, on_event=None\):) Tj T* (    """Run every scenario described by `plan`, with per-scenario budgets, self-checks and resume.) Tj T*  T* (    Shared by the command line and the GUI so both behave exactly the same. `on_event\(kind, payload\)`) Tj T* (    is an optional progress callback; kinds: "scenario_start" -> \(index, total, scenario\),) Tj T* (    "scenario_done" -> \(scenario, status, runs\). Returns the per-scenario \(scenario, status, runs\) list.) Tj T* (    """) Tj T* (    global WORKERS, REG_ENFORCE) Tj T* (    WORKERS = max\(1, int\(plan.get\("workers"\) or WORKERS\)\)) Tj T* (    REG_ENFORCE = plan.get\("reg_enforce", REG_ENFORCE\)) Tj T* (    apply_plan_numbers\(plan\)) Tj T* (    init_grid\(\)) Tj T* (    scs = plan_scenarios\(plan\)) Tj T* (    t_end = time.time\(\) + plan["hours"] * 3600) Tj T* (    overview = []) Tj T* (    for i, sc in enumerate\(scs\):) Tj T* (        if INTERRUPT.is_set\(\):) Tj T* (            overview.append\(\(sc, "not started \(stopped\)", 0\)\)) Tj T* (            if on_event:) Tj T* (                on_event\("scenario_done", \(i, sc, "not started \(stopped\)", 0\)\)) Tj T* (            continue) Tj T* (        budget = \(t_end - time.time\(\)\) / 3600 / \(len\(scs\) - i\)) Tj T* (        if budget < 0.005 and not check_only:) Tj T* (            overview.append\(\(sc, "not started \(no time left\)", 0\)\)) Tj T* (            if on_event:) Tj T* (                on_event\("scenario_done", \(i, sc, "not started \(no time left\)", 0\)\)) Tj T* (            continue) Tj T* (        if on_event:) Tj T* (            on_event\("scenario_start", \(i, len\(scs\), sc\)\)) Tj T* (        status, n = run_scenario\(sc, max\(budget, 0.01\), mains, flaps_pool, plan, check_only, no_check, resume\)) Tj T* (        overview.append\(\(sc, status, n\)\)) Tj T* (        if on_event:) Tj T* (            on_event\("scenario_done", \(i, sc, status, n\)\)) Tj T* (    print\("\\n" + "=" * 78 + "\\nALL DONE"\)) Tj T* (    for sc, status, n in overview:) Tj T* (        print\(f"  {scenario_label\(sc, plan.get\('chord'\)\):<60} {status}" + \(f", {n} runs" if n else ""\) + f"\\n      {scenario_dir\(sc\)}"\)) Tj T* (    return overview) Tj T* ET
