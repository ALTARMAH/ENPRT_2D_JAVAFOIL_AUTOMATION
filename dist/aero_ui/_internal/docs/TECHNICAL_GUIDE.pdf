%PreformattedPara
.945098 .960784 .976471 rg
BT 1 0 0 1 0 352.4 Tm /F3 7.6 Tf 10 TL (def streamlines\(x, y, u, v, seeds, n=600, ds=None\):) Tj T* (    """Trace streamlines from seeds \(list of \(x0, y0\)\) both up- and down-flow. Returns list of) Tj T* (    point lists in data coordinates.""") Tj T* (    if ds is None:) Tj T* (        ds = \(x[0, -1] - x[0, 0]\) / \(u.shape[1] * 4\)) Tj T* (    ok = np.isfinite\(u\)) Tj T* (    uu = np.where\(ok, u, 0.0\)) Tj T* (    vv = np.where\(ok, v, 0.0\)) Tj T* (    x0 = x[0, 0]) Tj T* (    y0 = y[0, 0]) Tj T* (    hx = \(x[0, 1] - x[0, 0]\)) Tj T* (    hy = \(y[1, 0] - y[0, 0]\)) Tj T* (    nx_, ny_ = u.shape) Tj T* (    lines = []) Tj T*  T* (    def step\(cur, sx0, sy0, dirn\):) Tj T* (        c = np.array\([sx0, sy0], float\)) Tj T* (        out = []) Tj T* (        for _ in range\(n\):) Tj T* (            ix = int\(\(c[0] - x0\) / hx\)) Tj T* (            iy = int\(\(c[1] - y0\) / hy\)) Tj T* (            if not \(0 <= ix < nx_ and 0 <= iy < ny_\):) Tj T* (                break) Tj T* (            s = float\(np.hypot\(uu[iy, ix], vv[iy, ix]\)\)) Tj T* (            if s < 1e-5 or not ok[iy, ix]:) Tj T* (                break) Tj T* (            c = c + dirn * np.array\([uu[iy, ix], vv[iy, ix]]\) / s * ds) Tj T* (            out.append\(\(float\(c[0]\), float\(c[1]\)\)\)) Tj T* (        return out) Tj T*  T* (    for \(sx0, sy0\) in seeds:) Tj T* (        up = step\(0, sx0, sy0, +1\)) Tj T* (        down = step\(0, sx0, sy0, -1\)) Tj T* (        pts = list\(reversed\(down\)\) + [\(sx0, sy0\)] + list\(up\)) Tj T* (        lines.append\(pts\)) Tj T* (    return lines) Tj T* ET
