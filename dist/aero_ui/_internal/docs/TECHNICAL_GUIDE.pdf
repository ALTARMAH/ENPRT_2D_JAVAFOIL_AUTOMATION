BT 1 0 0 1 0 192.4 Tm /F3 7.6 Tf 10 TL (def force_columns\(m\):) Tj T* (    """Downforce / drag in newtons at the design alpha. Assumes Cl and Cd are referenced to the main plane chord) Tj T* (    \(check this in JavaFoil\) and that the wing is a 2D extrusion over the given span, so it is an estimate.""") Tj T* (    if m is None:) Tj T* (        return {}) Tj T* (    chord_mm = speed = span_mm = None) Tj T* (    if PHYS and PHYS.get\("span_mm"\) and PHYS.get\("chord_mm"\) and PHYS.get\("speed"\):) Tj T* (        chord_mm, speed, span_mm = PHYS["chord_mm"], PHYS["speed"], PHYS["span_mm"]) Tj T* (    else:) Tj T* (        speed = SPEED) Tj T* (        chord_mm = CHORD_MM or DEFAULT_CHORD_MM) Tj T* (        span_mm = {"fw": DEFAULT_SPAN_FW_MM, "rw": DEFAULT_SPAN_RW_MM}.get\(ROLE, 1000.0\)) Tj T* (    if not \(chord_mm and speed and span_mm\):) Tj T* (        return {}) Tj T* (    cl0, cd0 = m.get\("Cl_a0"\), m.get\("Cd_a0"\)) Tj T* (    if pd.isna\(cl0\) or pd.isna\(cd0\):) Tj T* (        return {}) Tj T* (    q = 0.5 * RHO * speed ** 2) Tj T* (    area = chord_mm / 1000 * span_mm / 1000) Tj T* (    return {"Downforce_N": abs\(cl0\) * q * area, "Drag_N": cd0 * q * area}) Tj T* ET
