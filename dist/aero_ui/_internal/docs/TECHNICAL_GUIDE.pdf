%PreformattedPara
.945098 .960784 .976471 rg
BT 1 0 0 1 0 182.4 Tm /F3 7.6 Tf 10 TL (def ensure_mm_columns\(d, chord\):) Tj T* (    """results.csv from older campaigns may lack the mm geometry columns; rebuild them.""") Tj T* (    d = d.copy\(\)) Tj T* (    needs = [c for c in \("Stack_Length_mm", "Stack_Height_mm", "Min_Clearance_mm"\) if c not in d.columns]) Tj T* (    if not needs:) Tj T* (        return d) Tj T* (    for i in range\(len\(d\)\):) Tj T* (        height = None if str\(d.iloc[i].get\("Flow", ""\)\).lower\(\) != "ground" \\) Tj T* (            else float\(d.iloc[i].get\("Height_pct", 0\) or 0\)) Tj T* (        cfg = A.row_to_cfg\(d.iloc[i]\)) Tj T* (        outs = A.build_outlines\(cfg, ground_h=height\)) Tj T* (        allp = np.vstack\(outs\) * chord) Tj T* (        vals = {"Stack_Length_mm": float\(allp[:, 0].max\(\) - allp[:, 0].min\(\)\),) Tj T* (                "Stack_Height_mm": float\(allp[:, 1].max\(\) - allp[:, 1].min\(\)\)}) Tj T* (        if height is not None:) Tj T* (            vals["Min_Clearance_mm"] = float\(allp[:, 1].min\(\)\)) Tj T* (        for c in needs:) Tj T* (            d.at[d.index[i], c] = vals.get\(c, np.nan\)) Tj T* (    return d) Tj T* ET
