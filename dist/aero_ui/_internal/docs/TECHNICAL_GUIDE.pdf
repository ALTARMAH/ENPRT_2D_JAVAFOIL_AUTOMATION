BT 1 0 0 1 0 342.4 Tm /F3 7.6 Tf 10 TL (    """Pure objective-scorer for the optimizer \(no Tk access - called from the worker\).) Tj T*  T* (    Maximizes the weighted sum of the selected objective contributions.) Tj T* (    """) Tj T* (    def num\(key\):) Tj T* (        v = row.get\(key\)) Tj T* (        try:) Tj T* (            v = float\(v\)) Tj T* (        except \(TypeError, ValueError\):) Tj T* (            return 0.0) Tj T* (        return v if math.isfinite\(v\) else 0.0) Tj T*  T* (    terms = []) Tj T* (    if "lift" in objs:                       # more negative Cl_a0 = more downforce) Tj T* (        terms.append\(num\("Cl_a0"\) * -1.0\)) Tj T* (    if "efficiency" in objs:                 # Max_LD \(positive\)) Tj T* (        terms.append\(0.2 * num\("Max_LD"\)\)) Tj T* (    if "stability" in objs:                  # minimize |Cl variation around alpha 0|) Tj T* (        var = \(num\("Cl_am2"\) - num\("Cl_a0"\)\) ** 2 + \(num\("Cl_ap2"\) - num\("Cl_a0"\)\) ** 2) Tj T* (        terms.append\(-math.sqrt\(var\)\)) Tj T* (    if "height" in objs:                     # minimize stack height \(mm\)) Tj T* (        terms.append\(-num\("Stack_Height_mm"\) / 100.0\)) Tj T* (    if "length" in objs:                     # minimize stack length \(mm\)) Tj T* (        terms.append\(-num\("Stack_Length_mm"\) / 100.0\)) Tj T* (    if "gap" in objs:                        # match the target main->F1 gap) Tj T* (        g = num\("Main_to_F1_Gap_pct"\)) Tj T* (        if g <= 0 and len\(objs\) == 1:) Tj T* (            return 0.0) Tj T* (        terms.append\(-abs\(g - targets["target_gap"]\)\)) Tj T* (    if "downforce" in objs:                  # maximize downforce \(N\)) Tj T* (        terms.append\(num\("Downforce_N"\) / 300.0\)) Tj T* (    if "target_eff" in objs:                 # Max_LD penalised by distance to target Cl) Tj T* (        delta = abs\(num\("Cl_a0"\) + targets["target_cl"]\)) Tj T* (        terms.append\(0.2 * num\("Max_LD"\) / \(1.0 + delta\)\)) Tj T* (    return float\(sum\(terms\)\)) Tj T* ET
