BT 1 0 0 1 0 262.4 Tm /F3 7.6 Tf 10 TL (def main\(argv=None\):) Tj T* (    ap = argparse.ArgumentParser\(prog="render_field"\)) Tj T* (    ap.add_argument\("--main", required=True, help="main element airfoil name"\)) Tj T* (    ap.add_argument\("--flap", action="append", default=[],) Tj T* (                    help="flap as 'airfoil,scale,angle,x,y' \(repeatable up to 3\)"\)) Tj T* (    ap.add_argument\("--alpha", type=float, default=0.0, help="angle of attack, deg"\)) Tj T* (    ap.add_argument\("--ground-height", type=float, default=None,) Tj T* (                    help="main height above ground as percent of chord \(rows the wing up; ground at y=0\)"\)) Tj T* (    ap.add_argument\("--chord-mm", type=float, default=300.0, help="chord in mm for the metric overlay"\)) Tj T* (    ap.add_argument\("--out", default="field.png"\)) Tj T* (    ap.add_argument\("--nx", type=int, default=300\)) Tj T* (    ap.add_argument\("--ny", type=int, default=300\)) Tj T* (    args = ap.parse_args\(argv\)) Tj T*  T* (    A.AIRFOILS.update\(A.load_all\(A.AIRFOIL_DIR\)\)) Tj T* (    flaps = []) Tj T* (    for f in args.flap:) Tj T* (        bits = f.split\(","\)) Tj T* (        if len\(bits\) != 5:) Tj T* (            raise SystemExit\("flap must be 'airfoil,scale,angle,x,y'"\)) Tj T* (        name, s, a, x, y = bits) Tj T* (        flaps.append\(\(name.strip\(\), float\(s\), float\(a\), float\(x\), float\(y\)\)\)) Tj T* (    cfg = \(args.main, tuple\(flaps\)\)) Tj T*  T* (    outs = A.build_outlines\(cfg, ground_h=args.ground_height\)) Tj T* (    if args.ground_height:) Tj T* (        ground_h = args.ground_height) Tj T* ET
