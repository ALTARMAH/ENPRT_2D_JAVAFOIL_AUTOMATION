BT 1 0 0 1 0 262.4 Tm /F3 7.6 Tf 10 TL (    """Slot gap, overlap and height step between neighbouring elements, stack size, ground clearance.) Tj T* (    All in % of the main chord. Overlap > 0: the next element's leading edge is ahead of the previous) Tj T* (    trailing edge; overlap < 0: there is an open gap in x.""") Tj T* (    outs = build_outlines\(cfg, ground_h\)) Tj T* (    cols = {}) Tj T* (    for k in range\(len\(outs\) - 1\):) Tj T* (        p, q = outs[k], outs[k + 1]) Tj T* (        te = p[np.argmax\(p[:, 0]\)]) Tj T* (        le = q[np.argmin\(q[:, 0]\)]) Tj T* (        cols[f"{PAIRS[k]}_Gap_pct"] = 100 * _min_gap\(p, q\)) Tj T* (        cols[f"{PAIRS[k]}_Overlap_pct"] = 100 * \(te[0] - le[0]\)) Tj T* (        cols[f"{PAIRS[k]}_Step_pct"] = 100 * \(le[1] - te[1]\)) Tj T* (    allp = np.vstack\(outs\)) Tj T* (    ymin, ymax = allp[:, 1].min\(\), allp[:, 1].max\(\)) Tj T* (    cols["Stack_Length_pct"] = 100 * \(allp[:, 0].max\(\) - allp[:, 0].min\(\)\)) Tj T* (    cols["Stack_Height_pct"] = 100 * \(ymax - ymin\)) Tj T* (    cols["Stack_Ymin_pct"] = 100 * ymin) Tj T* (    cols["Stack_Ymax_pct"] = 100 * ymax) Tj T* (    h = GROUND_H if ground_h is UNSET else ground_h) Tj T* (    if h is not None:) Tj T* (        cols["Min_Clearance_pct"] = 100 * ymin) Tj T* (    if CHORD_MM:) Tj T* (        cols["Stack_Length_mm"] = \(allp[:, 0].max\(\) - allp[:, 0].min\(\)\) * CHORD_MM) Tj T* (        cols["Stack_Height_mm"] = \(ymax - ymin\) * CHORD_MM) Tj T* (        if h is not None:) Tj T* (            cols["Min_Clearance_mm"] = ymin * CHORD_MM) Tj T* (    return cols) Tj T* ET
