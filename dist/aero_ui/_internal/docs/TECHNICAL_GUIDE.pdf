BT 1 0 0 1 0 662.4 Tm /F3 7.6 Tf 10 TL (def simulate\(cfg, wdir, ground_h\):) Tj T* (    """Runs one JavaFoil analysis inside the worker folder. Returns \(metrics, status, debug lines\).""") Tj T* (    # Ensure airfoils are loaded in worker process) Tj T* (    if not AIRFOILS:) Tj T* (        AIRFOILS.update\(load_all\(AIRFOIL_DIR\)\)) Tj T* (        if os.path.isdir\(AIRFOIL_STORE\):) Tj T* (            AIRFOILS.update\(load_all\(AIRFOIL_STORE\)\)) Tj T* (    uid = uuid.uuid4\(\).hex[:8]) Tj T* (    wing_fn, script_fn, polar_fn = f"wing_{uid}.txt", f"script_{uid}.jfs", f"polar_{uid}.txt") Tj T* (    wing, script, polar = \(os.path.join\(wdir, f\) for f in \(wing_fn, script_fn, polar_fn\)\)) Tj T* (    logf = os.path.join\(wdir, f"java_{uid}.log"\)) Tj T* (    try:) Tj T* (        try:) Tj T* (            with open\(wing, "w"\) as f:) Tj T* (                f.write\("Automated Multi-Element Wing\\n"\)) Tj T* (                for i, o in enumerate\(build_outlines\(cfg, ground_h\)\):) Tj T* (                    if i > 0:) Tj T* (                        f.write\("9999.9 9999.9\\n"\)) Tj T* (                    for pt in o:) Tj T* (                        f.write\(f"{pt[0]:.6f} {pt[1]:.6f}\\n"\)) Tj T* (            a0, a1, st = ALPHA) Tj T* (            with open\(script, "w"\) as f:) Tj T* (                f.write\(f"""Options.Country\(10\);) Tj T* (Geometry.Open\("{wing_fn}"\);) Tj T* (Options.MachNumber\(0\);) Tj T* (Options.StallModel\(0\);) Tj T* (Options.TransitionModel\(1\);) Tj T* (Options.GroundEffect\({1 if ground_h is not None else 0}\);) Tj T* (Options.HeightOverSpan\(0.5\);) Tj T* (Options.AspectRatio\(0\);) Tj T* (Options.SweepAngle\(0.0\);) Tj T* (Polar.Analyze\({RE:g},{RE:g},{RE:g},{a0:g},{a1:g},{st:g},100,100,0,0\);) Tj T* (Polar.Save\("{polar_fn}"\);) Tj T* (JavaFoil.Exit\(\);) Tj T* ("""\)) Tj T* (        except Exception as e:) Tj T* (            # A geometry or disk problem \(bad config, full disk, permission\) becomes a normal failed) Tj T* (            # run instead of an unhandled worker exception that aborts the batch.) Tj T* (            return \(None, f"Setup Error: {type\(e\).__name__}: {e}", [f"cwd: {wdir}", str\(e\)]\)) Tj T* (        if shutil.which\("faketime"\):) Tj T* (            cmd = ["faketime", "-f", safe_date_str, "java", "-client", "-Xverify:none", "-XX:TieredStopAtLevel=1",) Tj T* (                   "-jar", JAVAFOIL_JAR, f"Script={script_fn}"]) Tj T* (        else:) Tj T* (            # Windows / minimal hosts: no faketime, so run Java directly \(the date is only pinned for) Tj T* (            # JavaFoil's license check; one best-effort attempt\).) Tj T* (            cmd = ["java", "-client", "-Xverify:none", "-XX:TieredStopAtLevel=1",) Tj T* (                   "-jar", JAVAFOIL_JAR, f"Script={script_fn}"]) Tj T* (        timed_out = False) Tj T* (        env = os.environ.copy\(\)) Tj T* (        if os.name != "nt":) Tj T* (            env["DISPLAY"] = os.environ.get\("DISPLAY", ":99"\)) Tj T* (        with open\(logf, "w"\) as jl:) Tj T* (            try:) Tj T* (                proc = subprocess.run\(cmd, cwd=wdir, stdout=jl, stderr=subprocess.STDOUT,) Tj T* (                                      timeout=RUN_TIMEOUT, env=env\)) Tj T* (            except subprocess.TimeoutExpired as e:) Tj T* (                timed_out = True) Tj T* (                proc = e) Tj T* (        diag = [f"cwd: {wdir}", f"exit code: {getattr\(proc, 'returncode', -1\)}"]) Tj T* (        try:) Tj T* (            diag += [l.rstrip\(\) for l in open\(logf, errors="ignore"\).read\(\).splitlines\(\) if l.strip\(\)][:8]) Tj T* (        except OSError:) Tj T* (            pass) Tj T* (        if timed_out:) Tj T* (            result = \(None, "JavaFoil Timeout", diag\)) Tj T* (        elif not \(os.path.exists\(polar\) and os.path.getsize\(polar\) > 0\):) Tj T* (            result = \(None, "No Output File", diag\)) Tj T* ET
