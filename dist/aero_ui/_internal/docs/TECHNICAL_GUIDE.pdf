BT 1 0 0 1 0 392.4 Tm /F3 7.6 Tf 10 TL (def resim_polar_curve\(r, wdir, chord, alphas=\(-18, 20, 2\)\):) Tj T* (    """Re-run JavaFoil with a denser alpha sweep for one config. Returns \(alpha, cl, cd\) rows.""") Tj T* (    import uuid) Tj T* (    height = None if str\(r.get\("Flow", ""\)\).lower\(\) != "ground" else float\(r.get\("Height_pct", 0\) or 0\)) Tj T* (    cfg = A.row_to_cfg\(r\)) Tj T* (    os.makedirs\(wdir, exist_ok=True\)) Tj T* (    uid = uuid.uuid4\(\).hex[:8]) Tj T* (    wing = os.path.join\(wdir, f"wing_{uid}.txt"\)) Tj T* (    script = os.path.join\(wdir, f"script_{uid}.jfs"\)) Tj T* (    polar = os.path.join\(wdir, f"polar_{uid}.txt"\)) Tj T* (    logf = os.path.join\(wdir, f"java_{uid}.log"\)) Tj T* (    with open\(wing, "w"\) as f:) Tj T* (        f.write\("Automated Multi-Element Wing\\n"\)) Tj T* (        for i, o in enumerate\(A.build_outlines\(cfg, ground_h=height\)\):) Tj T* (            if i > 0:) Tj T* (                f.write\("9999.9 9999.9\\n"\)) Tj T* (            for pt in o:) Tj T* (                f.write\(f"{pt[0]:.6f} {pt[1]:.6f}\\n"\)) Tj T* (    a0, a1, st = alphas) Tj T* (    with open\(script, "w"\) as f:) Tj T* (        f.write\(f"""Options.Country\(10\);) Tj T* (Geometry.Open\("{wing}"\);) Tj T* (Options.MachNumber\(0\);) Tj T* (Options.StallModel\(0\);) Tj T* (Options.TransitionModel\(1\);) Tj T* (Options.GroundEffect\({1 if height is not None else 0}\);) Tj T* (Options.HeightOverSpan\(0.5\);) Tj T* (Options.AspectRatio\(0\);) Tj T* (Options.SweepAngle\(0.0\);) Tj T* (Polar.Analyze\({A.RE:g},{A.RE:g},{A.RE:g},{a0:g},{a1:g},{st:g},100,100,0,0\);) Tj T* (Polar.Save\("{os.path.basename\(polar\)}"\);) Tj T* (JavaFoil.Exit\(\);) Tj T* ("""\)) Tj T* (    cmd = ["faketime", "-f", A.safe_date_str, "java", "-client", "-Xverify:none", "-XX:TieredStopAtLevel=1",) Tj T* (           "-jar", os.path.join\(A.JAVA_DIR, A.JAVAFOIL_JAR\), f"Script={os.path.basename\(script\)}"]) Tj T* (    with open\(logf, "w"\) as jl:) Tj T* (        proc = subprocess.Popen\(cmd, cwd=wdir, stdout=jl, stderr=subprocess.STDOUT, start_new_session=True\)) Tj T* (        try:) Tj T* (            proc.wait\(timeout=3 * A.RUN_TIMEOUT\)) Tj T* (        except subprocess.TimeoutExpired:) Tj T* ET
Q
 
