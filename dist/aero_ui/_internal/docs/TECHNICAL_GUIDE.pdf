BT 1 0 0 1 0 592.4 Tm /F3 7.6 Tf 10 TL (    """Illustrative velocity field. Returns X, Y, U, V \(inside elements = NaN\).) Tj T*  T* (    Cls: per-element lift coefficients \(in the aero_convention, so s1223 inverted is ~ -1.6\).) Tj T* (    ground_h: distance from ground \(y=0\) to the leading edge. Enables the mirrored ground.) Tj T* (    """) Tj T* (    outs = [np.asarray\(o, float\) for o in outs]) Tj T* (    a = np.radians\(alpha\)) Tj T* (    vinf = np.array\([np.cos\(a\), np.sin\(a\)]\) * UINF) Tj T* (    panels, _starts, decs = build_panels\(outs\)) Tj T* (    Gamma = element_circulation\(outs, Cls, alpha\)) Tj T* (    qpts = [element_quarter\(o\) for o in decs]) Tj T* (    z1a = np.array\([p["p1"][0] + 1j * p["p1"][1] for p in panels]\)) Tj T* (    z2a = np.array\([p["p2"][0] + 1j * p["p2"][1] for p in panels]\)) Tj T* (    sa = np.array\([p["s"] for p in panels]\)) Tj T* (    qx = np.array\([q[0] + 1j * q[1] for q in qpts]\)) Tj T* (    mivec = np.array\([block * UINF * float\(sum\(p["s"] for p in panels if p["el"] == ei\)\)) Tj T* (                      for ei in range\(len\(outs\)\)]\)) Tj T* (    mirror_on = ground_h is not None) Tj T*  T* (    if bounds is None:) Tj T* (        xmin = min\(o[:, 0].min\(\) for o in outs\)) Tj T* (        xmax = max\(o[:, 0].max\(\) for o in outs\)) Tj T* (        ymin = min\(o[:, 1].min\(\) for o in outs\)) Tj T* (        ymax = max\(o[:, 1].max\(\) for o in outs\)) Tj T* (        span = max\(xmax - xmin, ymax - ymin, 0.5\)) Tj T* (        bounds = \(xmin - 0.35 * span, xmax + 0.45 * span, ymin - 0.7 * span, ymax + 0.7 * span\)) Tj T* (    x, y = np.meshgrid\(np.linspace\(bounds[0], bounds[1], nx\), np.linspace\(bounds[2], bounds[3], ny\)\)) Tj T* (    xf = x.ravel\(\)) Tj T* (    yf = y.ravel\(\)) Tj T* (    z = xf + 1j * yf) Tj T*  T* (    u = np.full\(z.shape, vinf[0]\)) Tj T* (    v = np.full\(z.shape, vinf[1]\)) Tj T* (    chunk = 4096) Tj T* (    for i in range\(0, len\(z\), chunk\):) Tj T* (        zc = z[i:i + chunk]) Tj T* (        dz1 = _soft\(zc[:, None] - z1a[None, :], 1e-2\)) Tj T* (        dz2 = _soft\(zc[:, None] - z2a[None, :], 1e-2\)) Tj T* (        src = \(np.log\(dz1\) - np.log\(dz2\)\) / \(2 * np.pi\)) Tj T* (        vel = \(src * sa[None, :] * \(block * UINF\)\).sum\(axis=1\)) Tj T* (        if mirror_on:) Tj T* (            zd = zc.real[:, None] + 1j * \(-zc.imag[:, None]\)) Tj T* (            mdz1 = _soft\(zd - z1a[None, :], 1e-2\)) Tj T* (            mdz2 = _soft\(zd - z2a[None, :], 1e-2\)) Tj T* (            msrc = \(np.log\(mdz1\) - np.log\(mdz2\)\) / \(2 * np.pi\)) Tj T* (            vel = vel + \(msrc * sa[None, :] * \(block * UINF\)\).sum\(axis=1\)) Tj T* (        # sinks + circulation vortices, and their ground images) Tj T* (        for ei in range\(len\(outs\)\):) Tj T* (            vel = vel + _vel_sink_pt\(zc, qx[ei], mivec[ei]\)) Tj T* (            vel = vel + _vel_vortex_pt\(zc, qx[ei], Gamma[ei]\)) Tj T* (            if mirror_on:) Tj T* (                vel = vel + _vel_sink_pt\(zc, qx[ei].conjugate\(\), mivec[ei]\)) Tj T* (                vel = vel + _vel_vortex_pt\(zc, qx[ei].conjugate\(\), -Gamma[ei]\)) Tj T* (        u[i:i + chunk] = u[i:i + chunk] + np.real\(vel\)) Tj T* (        v[i:i + chunk] = v[i:i + chunk] + \(-np.imag\(vel\)\)) Tj T*  T* (    inside = _points_in_poly_many\(outs, xf, yf\)) Tj T* (    u[inside] = np.nan) Tj T* (    v[inside] = np.nan) Tj T* (    return x, y, u.reshape\(x.shape\), v.reshape\(x.shape\)) Tj T* ET
