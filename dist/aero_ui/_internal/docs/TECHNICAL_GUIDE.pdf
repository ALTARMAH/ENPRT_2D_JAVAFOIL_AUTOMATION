 Tj T* (                    key = cfg_key\(c\)) Tj T* (                    with LOCK:) Tj T* (                        known = key in DONE) Tj T* (                    if not known and key not in seen and geometry_ok\(c\):) Tj T* (                        seen.add\(key\); round_cfgs.append\(c\)) Tj T* (        random.shuffle\(round_cfgs\)) Tj T* (        round_cfgs = round_cfgs[:cap]) Tj T* (        if not round_cfgs:) Tj T* (            if k < 60:) Tj T* (                k += 8) Tj T* (                print\(f"Neighbourhood exhausted, widening to the best {k} per element count"\)) Tj T* (                continue) Tj T* (            print\("Refinement converged \(nothing new to test\)."\)) Tj T* (            break) Tj T* (        run_batch\(round_cfgs, "refine", deadline\)) Tj T* (        show\(progress_line\(\)\)) Tj T* (        check_fail_streak\(\)) Tj T* (        if time.time\(\) - last_out > SUMMARY_EVERY:) Tj T* (            write_outputs\(\); last_out = time.time\(\)) Tj T* ET
